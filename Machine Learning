plt.show()

correlation=df["cement"].corr(df["concrete_compressive_strength"])
print(correlation)
df1=pd.DataFrame(df.corr())
df1.to_csv("Correlation.csv")

import sklearn
print(sklearn.__version__)

x=df[["cement"]]
y=df["concrete_compressive_strength"]

from sklearn.model_selection import train_test_split
x_train, x_test, y_train, y_test=train_test_split(x,y,test_size=0.2,random_state=42)
print(x_train.shape)
print(x_test.shape)
print(y_test.shape)
from sklearn.linear_model import LinearRegression
model=LinearRegression()
model.fit(x_train,y_train)

print("Slope a is:",model.coef_)
print("Inter b is:",model.intercept_)

prediction=model.predict(x_test)
print(prediction[:8])
print(y_test[:8].values)

from sklearn.metrics import mean_absolute_error,r2_score
MAE=mean_absolute_error(y_test,prediction)
R2=r2_score(y_test,prediction)
print("MAE is:",MAE)
print("R2 is:",R2)



## Random Forest
from sklearn.ensemble import RandomForestRegressor
Rf_model=RandomForestRegressor()
Rf_model.fit(x_train,y_train)
Rf_prediction=Rf_model.predict(x_test)

from sklearn.metrics import mean_absolute_error,r2_score
Rf_MAE=mean_absolute_error(y_test,Rf_prediction)
Rf_R2=r2_score(y_test,Rf_prediction)

print("RF_MAE is:",Rf_MAE)
print("RF_R2 is:",Rf_R2)

Importances=({"Features":x.columns,"Importance":Rf_model.feature_importances_})
print(Importances)

train_prediction=Rf_model.predict(x_train)
train_MAE=mean_absolute_error(y_train,train_prediction)
train_R2=r2_score(y_train,train_prediction)

print("Training MAE:", train_MAE)
print("Training R²:", train_R2)
print("RF_MAE is:",Rf_MAE)
print("RF_R2 is:",Rf_R2)

print("Gap between training and test R²:", train_R2 - Rf_R2)
